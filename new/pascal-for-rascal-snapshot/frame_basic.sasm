; double(x) = x * 2, using a parameter and a local temp
    push 21
    call double
    print
    newline
    halt
double:
    enter 2          ; slot 0 = param x, slot 1 = local temp
    store_local 0    ; pull the pushed arg into local 0
    load_local 0
    push 2
    mul
    store_local 1    ; temp = x * 2
    load_local 1
    ret              ; leave result on the operand stack
