.var result integer

    jmp L21 ; 0000
L1:
    enter 2 ; 0001
    store_local 0 ; 0002
    load_local 0 ; 0003
    push 0 ; 0004
    eq ; 0005
    jz L10 ; 0006
    push 0 ; 0007
    store_local 1 ; 0008
    jmp L18 ; 0009
L10:
    load_local 0 ; 0010
