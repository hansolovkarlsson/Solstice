.var number integer

    push 5 ; 0000
    store number ; 0001
    push_str "val:" ; 0002
    print_str ; 0003
    load number ; 0004
    print ; 0005
    newline ; 0006
    push_str "a" ; 0007
    print_str ; 0008
    push_str "b" ; 0009
    print_str ; 0010
    push_str "c" ; 0011
    print_str ; 0012
    newline ; 0013
    newline ; 0014
    push_str "mixed: " ; 0015
    print_str ; 0016
    push 42 ; 0017
    print ; 0018
    push_str " and " ; 0019
    print_str ; 0020
    push 1 ; 0021
    print ; 0022
    newline ; 0023
    push_str "no newline at end" ; 0024
    print_str ; 0025
    halt ; 0026
