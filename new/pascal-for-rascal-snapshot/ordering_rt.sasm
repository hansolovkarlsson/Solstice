.var a string
.var b string

    push_str "apple" ; 0000
    store a ; 0001
    push_str "banana" ; 0002
    store b ; 0003
    load a ; 0004
    load b ; 0005
    scmp ; 0006
    push 0 ; 0007
    lt ; 0008
    jz L14 ; 0009
    push_str "apple < banana: true" ; 0010
    print_str ; 0011
    newline ; 0012
    jmp L17 ; 0013
L14:
    push_str "apple < banana: false" ; 0014
    print_str ; 0015
    newline ; 0016
L17:
    load a ; 0017
    load b ; 0018
    scmp ; 0019
    push 0 ; 0020
    gt ; 0021
    jz L27 ; 0022
    push_str "apple > banana: true" ; 0023
    print_str ; 0024
    newline ; 0025
    jmp L30 ; 0026
L27:
    push_str "apple > banana: false" ; 0027
    print_str ; 0028
    newline ; 0029
L30:
    load a ; 0030
    push_str "apple" ; 0031
    scmp ; 0032
    push 0 ; 0033
    lte ; 0034
    jz L39 ; 0035
    push_str "apple <= apple: true" ; 0036
    print_str ; 0037
    newline ; 0038
L39:
    load a ; 0039
    push_str "apple" ; 0040
    scmp ; 0041
    push 0 ; 0042
    gte ; 0043
    jz L48 ; 0044
    push_str "apple >= apple: true" ; 0045
    print_str ; 0046
    newline ; 0047
L48:
    push_str "sorted check: " ; 0048
    print_str ; 0049
    push_str "apple" ; 0050
    push_str "banana" ; 0051
    scmp ; 0052
    push 0 ; 0053
    lt ; 0054
    print ; 0055
    push_str " " ; 0056
    print_str ; 0057
    push_str "zebra" ; 0058
    push_str "apple" ; 0059
    scmp ; 0060
    push 0 ; 0061
    lt ; 0062
