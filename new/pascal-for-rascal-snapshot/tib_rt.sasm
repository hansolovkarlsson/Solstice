.var a integer
.var b integer

    push 6 ; 0000
    store a ; 0001
    push 3 ; 0002
    store b ; 0003
    push_str "6 and 3 = " ; 0004
    print_str ; 0005
    load a ; 0006
    load b ; 0007
    band ; 0008
    print ; 0009
    newline ; 0010
    push_str "6 or 3 = " ; 0011
    print_str ; 0012
    load a ; 0013
    load b ; 0014
    bor ; 0015
    print ; 0016
    newline ; 0017
    push_str "6 xor 3 = " ; 0018
    print_str ; 0019
    load a ; 0020
    load b ; 0021
    bxor ; 0022
    print ; 0023
    newline ; 0024
    push_str "not 0 = " ; 0025
    print_str ; 0026
    load a ; 0027
    bnot ; 0028
    load a ; 0029
    sub ; 0030
    print ; 0031
    newline ; 0032
    push_str "not 5 = " ; 0033
    print_str ; 0034
    push -6 ; 0035
    print ; 0036
    newline ; 0037
    push_str "not 0 = " ; 0038
    print_str ; 0039
    push -1 ; 0040
    print ; 0041
    newline ; 0042
    push_str "1 shl 4 = " ; 0043
    print_str ; 0044
    push 16 ; 0045
    print ; 0046
    newline ; 0047
    push_str "256 shr 4 = " ; 0048
    print_str ; 0049
    push 16 ; 0050
    print ; 0051
    newline ; 0052
    push_str "-1 shr 28 = " ; 0053
    print_str ; 0054
    push 15 ; 0055
    print ; 0056
    newline ; 0057
    halt ; 0058
