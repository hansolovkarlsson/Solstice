.var s string
.var i integer
.var __for_tmp2 integer

    jmp L15 ; 0000
L1:
    enter 1 ; 0001
    push_str "World" ; 0002
    store_local 0 ; 0003
    load_local 0 ; 0004
    push 1 ; 0005
    push_str "w" ; 0006
    str_char_replace ; 0007
    store_local 0 ; 0008
    push_str "local: " ; 0009
    print_str ; 0010
    load_local 0 ; 0011
    print_str ; 0012
    newline ; 0013
    ret ; 0014
L15:
    push_str "Hello" ; 0015
    store s ; 0016
    push_str "before: " ; 0017
    print_str ; 0018
    load s ; 0019
    print_str ; 0020
    newline ; 0021
    load s ; 0022
    push 1 ; 0023
    push_str "J" ; 0024
    str_char_replace ; 0025
    store s ; 0026
    push_str "after s[1]:=J: " ; 0027
    print_str ; 0028
    load s ; 0029
    print_str ; 0030
    newline ; 0031
    push 1 ; 0032
    store i ; 0033
    load s ; 0034
    length ; 0035
    store __for_tmp2 ; 0036
L37:
    load i ; 0037
    load __for_tmp2 ; 0038
    lte ; 0039
    jz L54 ; 0040
    load s ; 0041
    load i ; 0042
    load s ; 0043
    load i ; 0044
    str_char_at ; 0045
    upcase_char ; 0046
    str_char_replace ; 0047
    store s ; 0048
    load i ; 0049
    push 1 ; 0050
    add ; 0051
    store i ; 0052
    jmp L37 ; 0053
L54:
    push_str "all upper: " ; 0054
    print_str ; 0055
    load s ; 0056
    print_str ; 0057
    newline ; 0058
    load s ; 0059
    push 1 ; 0060
    str_char_at ; 0061
    push_str "J" ; 0062
    seq ; 0063
    jz L68 ; 0064
    push_str "s[1] correctly reads back as J" ; 0065
    print_str ; 0066
    newline ; 0067
L68:
    call L1 ; 0068
    halt ; 0069
