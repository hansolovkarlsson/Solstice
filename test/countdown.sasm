; Countdown loop, equivalent to:
;   var i: integer;
;   begin
;     i := 5;
;     while i > 0 do begin
;       writeln(i);
;       i := i - 1;
;     end;
;   end.

.var i integer

    push 5
    store i
loop:
    load i
    push 0
    gt
    jz done
    load i
    print
    load i
    push 1
    sub
    store i
    jmp loop
done:
    halt
